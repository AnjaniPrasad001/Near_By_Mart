# ===========================================
# Near By Mart — Environment Variables
# ===========================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env files to version control.

# ----------- Server -----------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ----------- MongoDB -----------
MONGODB_URI=mongodb://localhost:27017/near-by-mart

# ----------- JWT -----------
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ----------- Cloudinary (Phase 5+) -----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ----------- AI / RAG (Phase 10+) -----------
# AI_API_KEY=
# AI_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# ----------- Google Maps (Phase 9+) -----------
# GOOGLE_MAPS_API_KEY=
