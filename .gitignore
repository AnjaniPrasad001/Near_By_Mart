# ===========================================
# Near By Mart — .gitignore
# ===========================================

# ----------- Dependencies -----------
node_modules/
bower_components/

# ----------- Environment -----------
.env
.env.local
.env.production
.env.staging
backend/.env

# ----------- Build Output -----------
dist/
build/
out/
.angular/
frontend/.angular/

# ----------- TypeScript -----------
*.js.map
*.tsbuildinfo

# ----------- Logs -----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------- OS Files -----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------- IDE / Editor -----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ----------- Testing -----------
coverage/
.nyc_output/

# ----------- Misc -----------
*.tgz
.tmp/
temp/
tmp/
uploads/
*.pid
*.seed
*.pid.lock
